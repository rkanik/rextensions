---
import { siteConfig } from '../lib/site'

interface Props {
  heading?: string
  support?: string
}

const {
  heading = 'Carry your extension list anywhere',
  support = 'Manage locally, export a file, or back up with Google — then restore on another Chromium browser.',
} = Astro.props

const cws = siteConfig.cwsUrl
const github = `https://github.com/${siteConfig.githubRepo}`
---

<section class="border-t border-ink/8 bg-graphite text-cloud">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 text-center">
    <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{heading}</h2>
    <p class="mx-auto mt-3 max-w-xl text-mist/90 leading-relaxed">{support}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      {
        cws ? (
          <a
            href={cws}
            class="inline-flex rounded-md bg-steel-bright px-5 py-2.5 text-sm font-bold text-white hover:bg-steel transition-colors"
            rel="noopener noreferrer"
            target="_blank"
          >
            Add to Chrome
          </a>
        ) : null
      }
      <a
        href={github}
        class="inline-flex rounded-md border border-cloud/25 px-5 py-2.5 text-sm font-bold text-cloud hover:bg-cloud/10 transition-colors"
        rel="noopener noreferrer"
        target="_blank"
      >
        View on GitHub
      </a>
      <a href="/how-it-works" class="inline-flex rounded-md px-5 py-2.5 text-sm font-bold text-mist hover:text-white transition-colors">
        How it works
      </a>
    </div>
  </div>
</section>
