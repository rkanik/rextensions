---
import { navCommunity, navProduct, siteConfig } from '../lib/site'

const year = new Date().getFullYear()
const github = `https://github.com/${siteConfig.githubRepo}`
---

<footer class="border-t border-ink/10 bg-mist">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <p class="font-display text-xl font-bold text-ink">{siteConfig.name}</p>
      <p class="mt-2 max-w-xs text-sm text-slate leading-relaxed">{siteConfig.tagline}</p>
    </div>
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-slate">Product</p>
      <ul class="mt-3 space-y-2 text-sm font-semibold">
        {navProduct.map((item) => (
          <li><a href={item.href} class="text-ink hover:text-steel-deep">{item.label}</a></li>
        ))}
        <li><a href="/privacy" class="text-ink hover:text-steel-deep">Privacy</a></li>
      </ul>
    </div>
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-slate">Community</p>
      <ul class="mt-3 space-y-2 text-sm font-semibold">
        {navCommunity.filter((i) => i.href !== '/privacy').map((item) => (
          <li><a href={item.href} class="text-ink hover:text-steel-deep">{item.label}</a></li>
        ))}
        <li>
          <a href={github} class="text-ink hover:text-steel-deep" rel="noopener noreferrer" target="_blank">
            GitHub
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-ink/8 px-4 py-4 text-center text-xs text-slate sm:px-6">
    © {year} {siteConfig.name}. Open source under MIT.
  </div>
</footer>
