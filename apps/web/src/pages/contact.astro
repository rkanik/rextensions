---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import { getGitHubUser, getGitHubRepo } from '../lib/github'
import { absoluteUrl, siteConfig } from '../lib/site'

const user = await getGitHubUser()
const repo = await getGitHubRepo()
const blog = user.blog?.startsWith('http') ? user.blog : user.blog ? `https://${user.blog}` : ''
const email = siteConfig.contactEmail

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Rextensions',
  url: absoluteUrl('/contact'),
  mainEntity: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: absoluteUrl('/'),
    sameAs: [repo.html_url, user.html_url],
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      url: `${repo.html_url}/issues`,
      ...(email ? { email } : {}),
    },
  },
}
---

<BaseLayout
  title="Contact"
  description="Contact the Rextensions maintainer via GitHub issues or the developer profile. Optional email when published."
  path="/contact"
  jsonLd={jsonLd}
>
  <PageHero
    title="Contact"
    lead="Reach the maintainer through GitHub or the personal site. No contact form on this static host."
  />
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 space-y-10">
    <section>
      <h2 class="font-display text-xl font-bold text-ink">Report a bug or request a feature</h2>
      <p class="mt-3 text-slate leading-relaxed">
        Open an issue on
        <a href={`${repo.html_url}/issues`} class="font-semibold text-steel-deep" rel="noopener noreferrer" target="_blank">
          {repo.full_name}
        </a>
        . Include Chrome version, extension version, and steps to reproduce.
      </p>
      <a
        href={`${repo.html_url}/issues/new`}
        class="mt-5 inline-flex rounded-md bg-steel px-4 py-2 text-sm font-bold text-white hover:bg-steel-bright"
        rel="noopener noreferrer"
        target="_blank"
      >
        New GitHub issue
      </a>
    </section>

    <section>
      <h2 class="font-display text-xl font-bold text-ink">Maintainer</h2>
      <p class="mt-3 text-slate leading-relaxed">
        {user.name} (<a href={user.html_url} class="font-semibold text-steel-deep" rel="noopener noreferrer" target="_blank">@{user.login}</a>).
        See the <a href="/developer" class="font-semibold text-steel-deep">Developer</a> page for bio and links.
      </p>
      {
        blog && (
          <p class="mt-3 text-slate">
            Personal site:{' '}
            <a href={blog} class="font-semibold text-steel-deep" rel="noopener noreferrer" target="_blank">
              {blog.replace(/^https?:\/\//, '')}
            </a>
          </p>
        )
      }
      {
        email ? (
          <p class="mt-3 text-slate">
            Email:{' '}
            <a href={`mailto:${email}`} class="font-semibold text-steel-deep">
              {email}
            </a>
          </p>
        ) : (
          <p class="mt-3 text-sm text-slate">
            No public email is published on the GitHub profile. Prefer issues for project topics.
          </p>
        )
      }
    </section>

    <section>
      <h2 class="font-display text-xl font-bold text-ink">Contribute</h2>
      <p class="mt-3 text-slate leading-relaxed">
        Want to send code? Read the <a href="/contribute" class="font-semibold text-steel-deep">Contribute</a> guide first.
      </p>
    </section>
  </div>
</BaseLayout>
